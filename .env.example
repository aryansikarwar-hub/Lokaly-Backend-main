# =============================================================
# Lokaly backend (Node.js + Express + MongoDB)
# =============================================================
# Copy to `.env` for local dev. On Render, set these as env vars
# in the service dashboard instead.

# ---- Core ----
NODE_ENV=development
PORT=5050

# Frontend origin (used for CORS). Comma-separated NOT supported —
# pick the canonical one. In dev: http://localhost:5173
CLIENT_URL=http://localhost:5173

# ---- Auth ----
# Min 16 chars in production. Generate: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_secret_min_16_chars
JWT_EXPIRES_IN=7d

# ---- MongoDB ----
# Use the same Atlas cluster as the recommendation API for now,
# or point at a separate `lokaly` DB if you split them later.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/social_commerce?retryWrites=true&w=majority

# ---- Recommendation API (HuggingFace Space) ----
# Local dev:  http://127.0.0.1:7861   (when running Flask locally)
# Production: https://sawan-kush-ecommerce-api.hf.space
RECOMMENDATION_API_URL=https://sawan-kush-ecommerce-api.hf.space
# HF free tier cold-starts can take 30-60s — give it room.
RECOMMENDATION_API_TIMEOUT=60000

# ---- Cloudinary (image uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Agora (live video) ----
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ---- SMTP (transactional email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lokaly <noreply@lokaly.app>

# ---- Logging ----
LOG_LEVEL=info
